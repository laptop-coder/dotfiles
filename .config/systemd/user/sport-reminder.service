[Unit]
Description=Reminder to do some exercises

[Service]
Type=oneshot
Environment=HOME=%h
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/bin/notify-send "Sport Reminder" "It's time to do some exercises!" -i "${HOME}/.config/dunst/icons/sport.svg"

[Install]
WantedBy=default.target

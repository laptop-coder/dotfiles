[Unit]
Description=Reminder to drink water

[Service]
Type=oneshot
Environment=HOME=%h
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/bin/notify-send "Water Reminder" "It's time to drink water!" -i "${HOME}/.config/dunst/icons/water.svg"

[Install]
WantedBy=default.target
